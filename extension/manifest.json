{
  "manifest_version": 3,
  "name": "Meeting Copilot",
  "version": "0.1.0",
  "description": "Visible meeting assistant: live transcript + context-grounded talking points for calls you're in (Google Meet, Microsoft Teams).",
  "permissions": ["tabCapture", "offscreen", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.deepgram.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Meeting Copilot (side panel)" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
